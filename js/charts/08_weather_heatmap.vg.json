        "Launceston",
        "Ballarat",
        "Portland",
        "Hobart",
        "MountGinini"
      ],
      "title": null,
      "axis": {
        "labelLimit": 130
      }
    },
    "color": {
      "field": "normalised_value",
      "type": "quantitative",
      "title": "Normalised intensity",
      "scale": {
        "scheme": "viridis"
      }
    },
    "tooltip": [
      {
        "field": "Location"
      },
      {
        "field": "metric"
      },
      {
        "field": "raw_value",
        "format": ".2f",
        "title": "Original value"
      }
    ]
