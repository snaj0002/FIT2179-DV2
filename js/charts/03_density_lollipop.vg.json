{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": {
    "left": 8,
    "right": 8,
    "top": 10,
    "bottom": 10
  },
  "width": "container",
  "height": 520,
  "data": {
    "url": "data/density_top_clean.csv"
  },
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 5
  },
  "encoding": {
    "y": {
      "field": "region",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {
        "labelLimit": 170,
        "labelFontSize": 11
      }
    },
    "x": {
      "field": "density",
      "type": "quantitative",
      "title": "People per km\u00b2",
      "axis": {
        "format": "~s",
        "grid": true,
        "tickCount": 5
      }
    },
    "color": {
      "field": "state",
      "type": "nominal",
      "title": "State",
      "scale": {
        "domain": [
          "NSW",
          "VIC",
          "QLD",
          "SA",
          "WA",
          "TAS",
          "NT",
          "ACT"
        ],
        "range": [
          "#2563EB",
          "#14B8A6",
          "#F59E0B",
          "#EF4444",
          "#8B5CF6",
          "#06B6D4",
          "#84CC16",
          "#64748B"
        ]
      },
      "legend": {
        "orient": "bottom",
        "columns": 4,
        "title": "State"
      }
    },
    "tooltip": [
      {
        "field": "region",
        "title": "Region"
      },
      {
        "field": "state",
        "title": "State"
      },
      {
        "field": "density",
        "title": "People per km\u00b2",
        "type": "quantitative",
        "format": ".1f"
      },
      {
        "field": "population",
        "title": "Population",
        "type": "quantitative",
        "format": ","
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#334155",
      "titleColor": "#0f172a",
      "gridColor": "#e5e7eb"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "orient": "bottom",
      "direction": "horizontal",
      "columns": 4
    }
  }
}